  m_Name: EXP-04
  m_EditorClassIdentifier: SectorX13.Runtime::SectorX13.Data.ExperimentData
  scenarioId: EXP-04
  title: Acetic Acid + Magnesium Hydroxide
  chemicalAId: CH-01
  chemicalBId: CH-08
  fixedConcentrationA: 5% v/v
  fixedQuantityA: 15 mL
  fixedConcentrationB: Suspension
  fixedQuantityB: 10 mL
  fixedConditions: 15 mL 5% Acetic Acid + 10 mL Mg(OH)2 suspension, ambient 22 C.
  reviewedRiskCategory: 1
  reviewStatus: 1
  reviewEvidence: X13-REV-2026-04
  dataVersion: 1.0.0
  controls:
  - Eye protection
  - Lab coat
  rationale: Weak acid neutralising a mild, sparingly soluble hydroxide suspension
    with minimal heat.
  observations: Milky suspension gradually clears as soluble magnesium acetate forms.
  equation: 2 CH3COOH + Mg(OH)2 -> Mg(CH3COO)2 + 2 H2O
  effectId: neutralisation_glow
  safetyNotes: Low acute hazard under dilute virtual preset.
  educationalOutcome: Demonstrates antacid-style neutralisation of a weak base suspension.
