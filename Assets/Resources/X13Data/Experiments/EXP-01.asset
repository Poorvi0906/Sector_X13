  title: Acetic Acid + Sodium Bicarbonate
  chemicalAId: CH-01
  chemicalBId: CH-09
  fixedConcentrationA: 5% v/v
  fixedQuantityA: 15 mL
  fixedConcentrationB: 0.5 M
  fixedQuantityB: 10 mL
  fixedConditions: 15 mL 5% Acetic Acid + 10 mL 0.5 M Sodium Bicarbonate, open beaker,
